	"label": "dome-cladding",
	"longdesc": "",
	"name": "dome-cladding",
	"node_position": {
		"x": 0.0,
		"y": 0.0
	},
	"nodes": [
		{
			"color": {
				"a": 1.0,
				"b": 0.0,
				"g": 0.0,
				"r": 0.0,
				"type": "Color"
			},
			"name": "About",
			"node_position": {
				"x": 0.0,
				"y": -300.0
			},
			"parameters": {},
			"seed": -300.0,
			"size": {
				"x": 800.0,
				"y": 200.0
			},
			"text": "Lunar dome reference finish. Imagegen plate study supplies the albedo; the editable PanelFinish shader supplies coordinated seams, fastener relief, roughness and AO. Export stock Godot/Godot 4 Standard to a fresh prefix. Deck: 2x2 plates per 9 model units; cladding: 4 bays x 2 storeys per 36 units; trim: V along the member; window: one bounded pane. Roof equipment remains editor-authored.",
			"title": "dome-cladding",
			"type": "comment"
		},
		{
			"name": "PanelFinish",
			"node_position": {
				"x": 0.0,
				"y": 0.0
			},
			"parameters": {},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "vec3(0.7)",
						"function": true,
						"name": "finish",
						"type": "rgb"
					}
				],
				"instance": "\nfloat $(name)_hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }\nfloat $(name)_noise(vec2 p, float n) {\n    vec2 i=floor(p*n), f=fract(p*n); f=f*f*(3.0-2.0*f);\n    return mix(mix($(name)_hash(mod(i,n)), $(name)_hash(mod(i+vec2(1,0),n)),f.x),\n               mix($(name)_hash(mod(i+vec2(0,1),n)), $(name)_hash(mod(i+vec2(1,1),n)),f.x),f.y);\n}\nfloat $(name)_box(vec2 p, vec2 c, vec2 r) {\n    vec2 q=abs(p-c)-r; return length(max(q,vec2(0)))+min(max(q.x,q.y),0.0);\n}\nfloat $(name)_line(float d, float width) { return 1.0-smoothstep(width,width+0.0015,abs(d)); }\nfloat $(name)_dot(vec2 p, vec2 c, float r) { return 1.0-smoothstep(r,r+0.002,length(p-c)); }\nfloat $(name)_bolts(vec2 p, vec2 inset) {\n    vec2 q=abs(p-0.5); return 1.0-smoothstep(0.009,0.014,length(q-(0.5-inset)));\n}\n\nvec4 $(name)_pattern(vec2 uv) {\n    vec2 p=vec2(fract(uv.x*4.0),fract(-uv.y*2.0));\n    vec2 cell=floor(vec2(fract(uv.x)*4.0,fract(-uv.y)*2.0));\n    float edge=min(p.x,1.0-p.x);\n    float seam=1.0-smoothstep(0.006,0.014,edge);\n    float plate=$(name)_box(p,vec2(0.5,0.36),vec2(0.46,0.30));\n    float inset=$(name)_line(plate,0.002);\n    float bolts=0.0;\n    for(int i=0;i<2;i++) for(int j=0;j<2;j++)\n        bolts=max(bolts,$(name)_dot(p*vec2(1,2),vec2(0.085+float(i)*0.83,0.20+float(j)*1.02),0.012));\n    float service=step(0.5,mod(cell.x,2.0));\n    float hatch=$(name)_box(p,vec2(0.51,0.25),vec2(0.155,0.125))-0.012;\n    float hatchline=$(name)_line(hatch,0.003)*service;\n    float hinge=$(name)_line(p.x-0.332,0.009)*step(0.17,p.y)*step(p.y,0.23)*service;\n    float latch=$(name)_box(p,vec2(0.642,0.255),vec2(0.011,0.022));\n    float handle=(1.0-smoothstep(0.0,0.004,latch))*service;\n    float grime=(1.0-smoothstep(0.01,0.07,edge))*0.022;\n    float wear=($(name)_noise(uv,32.0)-0.5)*0.025+($(name)_noise(uv,300.0)-0.5)*0.012;\n    float tone=0.88+($(name)_hash(cell)-0.5)*0.04+wear-grime;\n    float detail=inset*0.10+bolts*0.25+hatchline*0.20+hinge*0.20+handle*0.28;\n    return vec4(tone-seam*0.26-detail,0.55-seam*0.22-inset*0.04-hatchline*0.07+bolts*0.035,\n                max(seam,max(inset*0.3,hatchline*0.6)),0.0);\n}\n\nvec3 $(name)_albedo(vec2 uv) { return min(vec3(0.96),mix($finish(uv),vec3(dot($finish(uv),vec3(0.333333))),0.25)*1.14); }\nvec3 $(name)_normal(vec2 uv) {\n    float e=1.0/1024.0;\n    float dx=($(name)_pattern(uv+vec2(e,0)).g-$(name)_pattern(uv-vec2(e,0)).g)/(2.0*e);\n    float dy=($(name)_pattern(uv+vec2(0,e)).g-$(name)_pattern(uv-vec2(0,e)).g)/(2.0*e);\n    vec3 n=normalize(vec3(-dx*.035,dy*.035,1.0));\n    // Material Maker's internal normal convention is flipped on X and Z by its exporter.\n    return n*vec3(-0.5,0.5,-0.5)+vec3(0.5);\n}\n",
				"name": "dome-cladding",
				"outputs": [
					{
						"rgb": "$(name)_albedo($uv)",
						"type": "rgb"
					},
					{
						"f": ".0",
						"type": "f"
					},
					{
						"f": ".57 + $(name)_noise($uv,64.0)*0.05",
						"type": "f"
					},
					{
						"rgb": "$(name)_normal($uv)",
						"type": "rgb"
					},
					{
						"f": "1.0-$(name)_pattern($uv).b*0.22",
						"type": "f"
					}
				],
				"parameters": []
			},
			"type": "shader"
		},
		{
			"export_paths": {},
