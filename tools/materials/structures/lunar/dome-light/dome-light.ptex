			"size": {
				"x": 800.0,
				"y": 200.0
			},
			"text": "Lunar dome reference finish. Imagegen plate study supplies the albedo; the editable PanelFinish shader supplies coordinated seams, fastener relief, roughness and AO. Export stock Godot/Godot 4 Standard to a fresh prefix. Deck: 2x2 plates per 9 model units; cladding: 4 bays x 2 storeys per 36 units; trim: V along the member; window: one bounded pane. Roof equipment remains editor-authored.",
			"title": "dome-light",
			"type": "comment"
		},
		{
			"name": "PanelFinish",
			"node_position": {
				"x": 0.0,
				"y": 0.0
			},
			"parameters": {},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [],
				"instance": "\nfloat $(name)_hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }\nfloat $(name)_noise(vec2 p, float n) {\n    vec2 i=floor(p*n), f=fract(p*n); f=f*f*(3.0-2.0*f);\n    return mix(mix($(name)_hash(mod(i,n)), $(name)_hash(mod(i+vec2(1,0),n)),f.x),\n               mix($(name)_hash(mod(i+vec2(0,1),n)), $(name)_hash(mod(i+vec2(1,1),n)),f.x),f.y);\n}\nfloat $(name)_box(vec2 p, vec2 c, vec2 r) {\n    vec2 q=abs(p-c)-r; return length(max(q,vec2(0)))+min(max(q.x,q.y),0.0);\n}\nfloat $(name)_line(float d, float width) { return 1.0-smoothstep(width,width+0.0015,abs(d)); }\nfloat $(name)_dot(vec2 p, vec2 c, float r) { return 1.0-smoothstep(r,r+0.002,length(p-c)); }\nfloat $(name)_bolts(vec2 p, vec2 inset) {\n    vec2 q=abs(p-0.5); return 1.0-smoothstep(0.009,0.014,length(q-(0.5-inset)));\n}\n\nvec4 $(name)_pattern(vec2 uv) { return vec4(0.85,0.5,0.0,0.0); }\n\nvec3 $(name)_albedo(vec2 uv) {\n    vec4 p=$(name)_pattern(uv);\n    return vec3(p.r)*vec3(1.0,0.99,0.94);\n}\nvec3 $(name)_normal(vec2 uv) {\n    float e=1.0/1024.0;\n    float dx=($(name)_pattern(uv+vec2(e,0)).g-$(name)_pattern(uv-vec2(e,0)).g)/(2.0*e);\n    float dy=($(name)_pattern(uv+vec2(0,e)).g-$(name)_pattern(uv-vec2(0,e)).g)/(2.0*e);\n    vec3 n=normalize(vec3(-dx*.035,dy*.035,1.0));\n    // Material Maker's internal normal convention is flipped on X and Z by its exporter.\n    return n*vec3(-0.5,0.5,-0.5)+vec3(0.5);\n}\n",
				"name": "dome-light",
				"outputs": [
					{
						"rgb": "$(name)_albedo($uv)",
						"type": "rgb"
					},
					{
						"f": ".0",
						"type": "f"
					},
					{
						"f": ".57 + $(name)_noise($uv,64.0)*0.05",
						"type": "f"
					},
					{
						"rgb": "$(name)_normal($uv)",
						"type": "rgb"
					},
					{
						"f": "1.0-$(name)_pattern($uv).b*0.22",
						"type": "f"
					}
				],
				"parameters": []
			},
			"type": "shader"
		},
		{
			"export_paths": {},
