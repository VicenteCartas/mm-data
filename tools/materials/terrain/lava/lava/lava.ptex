    {
      "name": "Notes",
      "type": "comment",
      "parameters": {},
      "seed_int": 0,
      "node_position": {
        "x": 0,
        "y": -350
      },
      "title": "Original HEAD lava \u2014 pigment and source registration protected",
      "text": "Pigment, normal and surface exports remain unchanged. Edit the four colors inside Emission, HeatResponse heat/crack strengths, and Material emission scale. Emission uses linear RGB: the same graph drives Material preview and lava-heat.png RGB; its alpha retains heat coverage. The exported lava.json supplies the same emission scale. Exposed coverage is already baked into RGB. Runtime only advects/blends this source and applies the shared shore/bank response and camera exposure. No shader heat-to-color ramp or separate preview color remains. Default scale 5 is a calibration candidate, not final visual acceptance. Cold-start official CLI behavior still needs a native export gate.",
      "size": {
        "x": 950,
        "y": 160
      },
      "color": {
        "type": "Color",
        "r": 0.18,
        "g": 0.23,
        "b": 0.28,
        "a": 1
      }
    },
