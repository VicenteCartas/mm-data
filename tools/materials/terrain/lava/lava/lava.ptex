        {
          "name": "Source_notes",
          "type": "comment",
          "parameters": {},
          "seed_int": 0,
          "node_position": {
            "x": 0,
            "y": -260
          },
          "title": "Registered original fields, two byte planes",
          "text": "The original Poisson/de-lighting/percentile recipe supplies height, its 7px neighbourhood, plate coverage and grain+0.5. Two standard PNG byte planes preserve 16-bit masks through the native half image loader. Round restores exact source bytes; (256*high+low)/65535 restores the registered values. These are source fields before normal/AO/roughness, not finished response maps.",
          "size": {
            "x": 950,
            "y": 160
          },
          "color": {
            "type": "Color",
            "r": 0.18,
            "g": 0.23,
            "b": 0.28,
            "a": 1
          }
