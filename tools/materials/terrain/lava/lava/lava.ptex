        {
          "name": "Response_notes",
          "type": "comment",
          "parameters": {},
          "seed_int": 0,
          "node_position": {
            "x": 0,
            "y": -260
          },
          "title": "Actual editable response, original defaults",
          "text": "Normals differentiate the original registered height; relief is quantized once and shared with surface A. AO = exp(-max(neighbour height - height,0)*Cavity strength). Roughness = clamp(Crack roughness + Plate roughness*plate - Grain roughness*grain,.24,.98). No final normal, AO or roughness source image. The fixed 12m reference is the existing runtime contract; no new repeat control is implied.",
          "size": {
            "x": 950,
            "y": 160
          },
          "color": {
            "type": "Color",
            "r": 0.18,
            "g": 0.23,
            "b": 0.28,
            "a": 1
          }
        }
