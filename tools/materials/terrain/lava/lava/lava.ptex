    {
      "name": "About",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -350
      },
      "size": {
        "x": 900,
        "y": 190
      },
      "title": "About this material",
      "text": "lava.tres is a ShaderMaterial of lava.gdshader: export it with this project's own target, File > Export material > Godot > Godot 4 ShaderMaterial (Godot 4 Standard would write a StandardMaterial3D the game refuses). The Export node writes lava_coverage.png, the map the shader adds. Edit SurfaceResponse, HeatResponse. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export into data/models/board/textures/terrain/lava, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.18,
        "g": 0.23,
        "b": 0.28,
        "a": 1
      }
    },
