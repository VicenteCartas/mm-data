        {
          "name": "RegisteredNotes",
          "type": "comment",
          "parameters": {},
          "seed_int": 0,
          "node_position": {
            "x": 0,
            "y": -300
          },
          "title": "Original internal scales; editable optical response",
          "text": "R/G/B preserve the original periodic5/15/29px neighbourhoods BEFORE normals, height, roughness, cloudiness and crack classification. Native nodes recompute those responses. Only the broad field drives geometric normals; internal cracks do not become grooves. No final response map is imported and no half buffer is inserted after byte-plane decode.",
          "size": {
            "x": 950,
            "y": 160
          },
          "color": {
            "type": "Color",
            "r": 0.18,
            "g": 0.23,
            "b": 0.28,
            "a": 1
          }
        }
