      "node_position": {
        "x": -650,
        "y": -750
      },
      "size": {
        "x": 900,
        "y": 190
      },
      "title": "About this material",
      "text": "Bark-chip mulch for concrete tree pits, over dark soil (sources/soil.png). AuthorControls sets the chips, colours, repeat, relief and roughness (it also sets the linked values in Normals). Repeat: 1 m, as in materials.json. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export: File > Export material > Godot > Godot 4 Standard into data/models/board/textures/terrain/surfaces, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.18,
        "g": 0.23,
        "b": 0.28,
        "a": 1
      }
    },
