            "y": 300
          },
          "widgets": [
            {
              "name": "ReliefPercent",
              "label": "Relief (% of the repeat)",
              "type": "named_parameter",
              "min": 0,
              "max": 5.0,
              "step": 0.0001,
              "default": 0.0625
            },
            {
              "name": "NormalStrength",
              "label": "Normal strength",
              "type": "named_parameter",
              "min": 0,
              "max": 4,
              "step": 0.01,
              "default": 1
            }
          ]
        },
        {
          "name": "MetricHeight",
          "type": "math",
          "node_position": {
            "x": -100,
            "y": 0
          },
          "parameters": {
            "op": 2,
            "default_in1": 0,
            "default_in2": "16*$ReliefPercent*$NormalStrength/100",
            "clamp": false
          },
          "seed": 27,
          "seed_locked": true
        },
        {
          "name": "Normal",
          "node_position": {
            "x": 250,
            "y": 0
          },
          "parameters": {
            "algo": 2,
            "amount": 1,
            "size": 9
          },
          "seed": -11547,
          "shader_model": {
            "code": "",
            "global": "",
            "inputs": [
              {
                "default": "0.0",
                "function": true,
                "label": "",
                "name": "in",
                "type": "f"
              }
            ],
            "instance": [
              "vec3 nm_$name(vec2 uv, float amount, float size) {",
              "\tvec3 e = vec3(1.0/size, -1.0/size, 0);",
              "\tvec2 rv;",
              "\tif ($algo == 0) {",
              "\t\trv = vec2(1.0, -1.0)*$in(uv+e.xy);",
              "\t\trv += vec2(-1.0, 1.0)*$in(uv-e.xy);",
              "\t\trv += vec2(1.0, 1.0)*$in(uv+e.xx);",
              "\t\trv += vec2(-1.0, -1.0)*$in(uv-e.xx);",
              "\t\trv += vec2(2.0, 0.0)*$in(uv+e.xz);",
              "\t\trv += vec2(-2.0, 0.0)*$in(uv-e.xz);",
              "\t\trv += vec2(0.0, 2.0)*$in(uv+e.zx);",
              "\t\trv += vec2(0.0, -2.0)*$in(uv-e.zx);",
              "\t\trv *= size*amount/128.0;",
              "\t} else if ($algo == 1) {",
              "\t\trv = vec2(3.0, -3.0)*$in(uv+e.xy);",
              "\t\trv += vec2(-3.0, 3.0)*$in(uv-e.xy);",
              "\t\trv += vec2(3.0, 3.0)*$in(uv+e.xx);",
              "\t\trv += vec2(-3.0, -3.0)*$in(uv-e.xx);",
              "\t\trv += vec2(10.0, 0.0)*$in(uv+e.xz);",
              "\t\trv += vec2(-10.0, 0.0)*$in(uv-e.xz);",
              "\t\trv += vec2(0.0, 10.0)*$in(uv+e.zx);",
              "\t\trv += vec2(0.0, -10.0)*$in(uv-e.zx);",
              "\t\trv *= size*amount/512.0;",
              "\t} else if ($algo == 2) {",
              "\t\trv = vec2(2.0, 0.0)*$in(uv+e.xz);",
              "\t\trv += vec2(-2.0, 0.0)*$in(uv-e.xz);",
              "\t\trv += vec2(0.0, 2.0)*$in(uv+e.zx);",
              "\t\trv += vec2(0.0, -2.0)*$in(uv-e.zx);",
              "\t\trv *= size*amount/64.0;",
              "\t} else {",
              "\t\trv = vec2(1.0, 0.0)*$in(uv+e.xz);",
              "\t\trv += vec2(0.0, 1.0)*$in(uv+e.zx);",
              "\t\trv += vec2(-1.0, -1.0)*$in(uv);",
              "\t\trv *= size*amount/20.0;",
              "\t}",
              "\treturn vec3(0.5)+0.5*normalize(vec3(rv, -1.0));",
              "}",
              ""
            ],
            "name": "Normal map",
            "outputs": [
              {
                "rgb": "nm_$name($uv, $amount, $size)",
                "type": "rgb"
              }
            ],
            "parameters": [
              {
                "default": 3,
                "label": "",
                "name": "algo",
                "type": "enum",
                "values": [
                  {
                    "name": "Sobel",
                    "value": "0"
                  },
                  {
                    "name": "Scharr",
                    "value": "1"
                  },
                  {
                    "name": "Simple",
                    "value": "2"
                  },
                  {
                    "name": "Cheap",
                    "value": "3"
                  }
                ]
              },
              {
                "default": 9,
                "first": 4,
                "label": "",
                "last": 12,
                "name": "size",
                "type": "size"
              },
              {
                "control": "None",
                "default": 0.5,
                "label": "",
                "max": 2,
                "min": 0,
                "name": "amount",
                "step": 0.01,
                "type": "float"
              }
            ]
          },
          "type": "shader"
        },
