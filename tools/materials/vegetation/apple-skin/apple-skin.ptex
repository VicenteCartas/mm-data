	"label": "Apple skin - red blush, yellow ground colour and lenticels",
	"longdesc": "",
	"name": "apple-skin",
	"node_position": {
		"x": 0.0,
		"y": 0.0
	},
	"nodes": [
		{
			"color": {
				"a": 1.0,
				"b": 0.180000007152557,
				"g": 0.259999990463257,
				"r": 0.180000007152557,
				"type": "Color"
			},
			"name": "About",
			"node_position": {
				"x": 0.0,
				"y": -400.0
			},
			"parameters": {},
			"seed": -400.0,
			"size": {
				"x": 900.0,
				"y": 190.0
			},
			"text": "Procedural apple epidermis. The spherical field closes around the UV seam: red blush, fine longitudinal striation, pale lenticels and a yellow-green ground colour. SurfaceResponse exposes waxy roughness and shallow pore relief. The existing PNG8 groups retain the exact exported codes. Use with the rounded, stemmed fruit in build_orchards.py; one UV repeat is one apple.",
			"title": "About this material",
			"type": "comment"
		},
		{
			"name": "Source",
			"node_position": {
				"x": 0.0,
				"y": 0.0
			},
			"parameters": {},
			"seed": 57.0,
			"seed_locked": true,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [],
				"instance": "\nfloat apple_hash_$name(vec3 p) {\n    return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);\n}\nfloat apple_noise_$name(vec3 p) {\n    vec3 q = floor(p), f = fract(p); f = f*f*(3.0-2.0*f);\n    return mix(mix(mix(apple_hash_$name(q), apple_hash_$name(q+vec3(1,0,0)), f.x),\n                   mix(apple_hash_$name(q+vec3(0,1,0)), apple_hash_$name(q+vec3(1,1,0)), f.x), f.y),\n               mix(mix(apple_hash_$name(q+vec3(0,0,1)), apple_hash_$name(q+vec3(1,0,1)), f.x),\n                   mix(apple_hash_$name(q+vec3(0,1,1)), apple_hash_$name(q+vec3(1,1,1)), f.x), f.y), f.z);\n}\nvec3 apple_point_$name(vec2 uv) {\n    float a = 6.28318530718 * uv.x, b = 3.14159265359 * uv.y;\n    return vec3(sin(b)*cos(a), sin(b)*sin(a), cos(b));\n}\nvec4 apple_colour_$name(vec2 uv) {\n    vec3 p = apple_point_$name(uv);\n    float mottling = apple_noise_$name(p*7.0+3.7);\n    float streak = apple_noise_$name(p*vec3(35.0,35.0,2.5));\n    float blush = smoothstep(0.18, 0.74, 0.65*mottling+0.35*streak+0.2*p.x);\n    vec3 colour = mix(vec3(.58,.41,.10), vec3(.72,.075,.045), .52+.48*blush);\n    colour *= .82+.28*apple_noise_$name(p*25.0+11.0);\n    float speck = smoothstep(.82,.89, apple_noise_$name(p*130.0+19.3));\n    colour = mix(colour, vec3(.72,.58,.29), speck*.65);\n    float russet = smoothstep(.965,.999,abs(p.z));\n    colour = mix(colour, vec3(.34,.24,.09), russet*.6);\n    return vec4(colour,1.0);\n}\nvec4 apple_fields_$name(vec2 uv) {\n    float pore = apple_noise_$name(apple_point_$name(uv)*130.0+19.3);\n    return vec4(pore,pore,pore,.2);\n}\n",
				"name": "Procedural apple epidermis",
				"outputs": [
					{
						"rgba": "apple_colour_$name($uv)",
						"type": "rgba"
					},
					{
						"rgba": "apple_fields_$name($uv)",
						"type": "rgba"
					}
				],
				"parameters": []
			},
			"type": "shader"
		},
